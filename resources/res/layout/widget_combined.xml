<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/rounded_background"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2">
        <ImageView
            android:id="@+id/widget_combined_avatars"
            android:layout_width="100dp"
            android:layout_height="56dp"
            android:layout_marginBottom="7dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_combined_avatars_description"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/widget_combined_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_zero_days"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-rounded"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ccffffff"
            android:id="@+id/widget_combined_together"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_together"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-rounded"/>
    </LinearLayout>
    <FrameLayout
        android:padding="8dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/widget_combined_memory"
            android:background="@drawable/rounded_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/image_placeholder"
            android:scaleType="centerCrop"
            android:clipToOutline="true"/>
    </FrameLayout>
</LinearLayout>
