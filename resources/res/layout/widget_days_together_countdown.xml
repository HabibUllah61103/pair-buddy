<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@drawable/rounded_background"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="10dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/widget_countdown_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_together_for"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-rounded"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="16sp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/widget_countdown_segments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <FrameLayout
            android:id="@+id/widget_countdown_days_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="start"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/widget_countdown_days_value"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:text="0"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-rounded"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="29sp"/>
                <TextView
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/widget_countdown_days_label"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    android:text="@string/widget_days_short"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeMaxTextSize="9sp"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="7dp"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="29sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text=":"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-rounded"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeMaxTextSize="29sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/widget_countdown_hours_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="35dp">
                <TextClock
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/widget_countdown_hours_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-rounded"
                    android:format12Hour="HH"
                    android:format24Hour="HH"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="29sp"/>
                <TextView
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/widget_countdown_hours_static"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="00"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-rounded"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="29sp"/>
            </FrameLayout>
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/widget_countdown_hours_label"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:text="@string/widget_hours_short"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="9sp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="7dp"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="29sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text=":"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-rounded"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeMaxTextSize="29sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/widget_countdown_minutes_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="35dp">
                <TextClock
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/widget_countdown_minutes_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-rounded"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="29sp"/>
                <TextView
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/widget_countdown_minutes_static"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="00"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-rounded"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="29sp"/>
            </FrameLayout>
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/widget_countdown_minutes_label"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:text="@string/widget_minutes_short"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="9sp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="7dp"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="29sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text=":"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-rounded"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeMaxTextSize="29sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/widget_countdown_seconds_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="35dp">
                <TextClock
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/widget_countdown_seconds_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-rounded"
                    android:format12Hour="ss"
                    android:format24Hour="ss"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="29sp"/>
                <TextView
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/widget_countdown_seconds_static"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="00"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-rounded"
                    android:autoSizeTextType="uniform"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeMaxTextSize="29sp"/>
            </FrameLayout>
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/widget_countdown_seconds_label"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:text="@string/widget_seconds_short"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:autoSizeTextType="uniform"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="9sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
