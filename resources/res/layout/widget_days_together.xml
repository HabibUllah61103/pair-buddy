<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/rounded_background"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_heart_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_heart"
        android:contentDescription="@string/widget_heart_icon_description"/>
    <TextView
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/widget_days_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:text="0"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-rounded"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#ff9f43"
        android:id="@+id/widget_days_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="@string/widget_days_together_lock_small_label"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
