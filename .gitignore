# ==============================================================================
# Git Ignore Configuration for Lovio Source / Pair-Buddy
# ==============================================================================

# --- Keystores, Cryptographic Keys & Certificates ---
*.keystore
*.jks
*.key
*.pem
*.p12
*.p8
*.pk8
*.crt
*.der
build-tools/*.keystore
build-tools/*.jks

# --- Secrets, Credentials & Local Environment Files ---
.env
.env.*
*.env
*.local
secrets/
credentials/
*credentials*.json
google-services.json
GoogleService-Info.plist

# --- Compiled Android Binaries & App Bundles ---
/apks/
*.apk
*.xapk
*.aab
*.apks

# --- Build Outputs & Temporary Artifacts ---
/build/
apktool-workspace/build/
dist/
out/
bin/
*.class
*.dex
*.obj
*.o

# --- Logs, Caches & Dumps ---
*.log
*.tmp
*.temp
*.dump
emulator/window_dump.xml
.cache/
.expo/
.expo-shared/

# --- Node & Package Managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
