{
  "expo": {
    "android": {
      "package": "com.pairbuddy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a623b480-66a6-49ef-9bdf-03b0a6fb964c"
      }
    },
    "ios": {
      "bundleIdentifier": "com.pairbuddy.app",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Pair Buddy shares your live distance with your partner, even when the app is closed.",
        "NSLocationWhenInUseUsageDescription": "Pair Buddy needs your location to show live distance to your partner."
      },
      "supportsTablet": true
    },
    "name": "Pair Buddy",
    "newArchEnabled": true,
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Pair Buddy shares your live distance with your partner, even when the app is closed.",
          "locationWhenInUsePermission": "Pair Buddy needs your location to show live distance to your partner."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#123B63",
          "icon": "./assets/icon.png"
        }
      ],
      "./plugins/withPairWidgets",
      "./plugins/withPairWidgetsIOS",
      "expo-audio"
    ],
    "scheme": "pairbuddy",
    "slug": "pair-buddy",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBF7"
    },
    "userInterfaceStyle": "automatic",
    "version": "0.1.0",
    "icon": "./assets/icon.png"
  }
}
